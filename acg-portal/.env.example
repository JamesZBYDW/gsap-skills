# ─── ACG Investor Portal — environment template ───────────────────────────────
# Copy to `.env` for local dev. NEVER commit a real `.env`. In production, set
# these in your host's secret manager (Vercel env, AWS SSM/Secrets Manager, etc.).

# PostgreSQL connection string. Local dev default matches docker-compose.
DATABASE_URL="postgresql://acg:acg_dev_password@127.0.0.1:5432/acg_portal?schema=public"

# Session signing/encryption secret. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates all existing sessions.
SESSION_SECRET="dev-only-insecure-secret-change-me-0123456789abcdef0123456789abcdef"

# Cookie/security posture. Set to "production" on real deployments so cookies
# are marked Secure and HSTS is enforced.
NODE_ENV="development"

# Public base URL of the deployment (used for signed document URLs, links).
APP_URL="http://localhost:3000"

# Signed-document URL secret + TTL (seconds). Documents are private; downloads
# use short-lived signed URLs. Generate like SESSION_SECRET.
DOCUMENT_URL_SECRET="dev-only-doc-secret-change-me-fedcba9876543210fedcba9876543210"
DOCUMENT_URL_TTL_SECONDS="300"

# Seed admin (team) + demo investor credentials. Used only by `npm run db:seed`.
# Change before any non-demo deployment.
SEED_TEAM_EMAIL="james@acg.example"
SEED_TEAM_PASSWORD="ChangeMe!Team123"
SEED_INVESTOR_EMAIL="m.vance@gmail.com"
SEED_INVESTOR_PASSWORD="ChangeMe!Inv1234"
