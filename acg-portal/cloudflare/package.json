{
  "name": "acg-portal-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that fronts the ACG portal container (Cloudflare Containers).",
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "deploy:prebuilt": "node scripts/deploy-prebuilt.mjs",
    "build:dry": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "2.1.8",
    "wrangler": "4.153.0"
  }
}
