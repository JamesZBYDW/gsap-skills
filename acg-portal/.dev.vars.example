# Local secrets for `wrangler dev` / `npm run preview` (copy to .dev.vars).
# Production values are Worker secrets: `npx wrangler secret put <NAME>`.
# Signs short-lived document links (32+ chars; without it they are disabled).
DOCUMENT_URL_SECRET="dev-only-document-url-secret-change-me-0123456789"
# Encrypts two-factor (TOTP) secrets; exactly 32 random bytes, base64url or
# base64. Production: openssl rand -base64 32 | npx wrangler secret put MFA_ENCRYPTION_KEY
# This value is for LOCAL development only.
MFA_ENCRYPTION_KEY="YWNnLXBvcnRhbC1sb2NhbC1kZXYtbWZhLWtleS0wMDA"
