# ─── ACG Investor Portal — production (Cloudflare Tunnel) environment ─────────
# Copy to `.env.production` on the server and fill in. `.env.production` is
# gitignored and excluded from the Docker build — never commit it.
#
# Used by: docker compose -f docker-compose.cloudflare.yml --env-file .env.production …

# Public URL investors will use (the hostname you route to the tunnel).
APP_URL="https://portal.acgroupinc.com"

# Two independent secrets, 48+ random bytes each:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
SESSION_SECRET=""
DOCUMENT_URL_SECRET=""

# Password for the bundled Postgres. Hex only, so it is safe inside a URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=""

# Tunnel token from the Cloudflare dashboard (Networking → Tunnels → your
# tunnel). Treat it like a password: anyone holding it can serve your hostname.
TUNNEL_TOKEN=""

# Optional — use a managed Postgres instead of the bundled one:
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/acg_portal?sslmode=require"
